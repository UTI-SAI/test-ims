<div class="modal modal-blur fade" id="modal-export-billing" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <form action="/billing/exports">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Export Billing</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <label class="form-label">Export Type</label>

                    <!-- Hidden fields -->
                    <input type="hidden" name="queryString" id="exportQueryString">
                    <input type="hidden" name="selectedIds" id="selectedIds">

                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="CURRENT"
                                    class="form-selectgroup-input" checked>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3"><span class="form-selectgroup-check"></span></span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">This Page</span>
                                        <span class="d-block text-muted">Only export this page ( filter applied )</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="ENTIRE"
                                    class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3"><span class="form-selectgroup-check"></span></span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Entire Records</span>
                                        <span class="d-block text-muted">Export entire records in database</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="MULTIPLE_INVOICE"
                                    id="exportMultipleInvoice" class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3"><span class="form-selectgroup-check"></span></span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Multiple Selection</span>
                                        <span class="d-block text-muted">Only Invoice</span>
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="MULTIPLE_ROW"
                                    id="exportMultipleRow" class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3"><span class="form-selectgroup-check"></span></span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Multiple Selection</span>
                                        <span class="d-block text-muted">Row data</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</a>
                    <button type="submit" class="btn btn-primary ms-auto" data-bs-dismiss="modal" id="exportSubmitBtn">
                        <svg xmlns="http://www.w3.org/2000/svg"
                            class="icon icon-tabler icon-tabler-database-export" width="24" height="24"
                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M4 6c0 1.657 3.582 3 8 3s8 -1.343 8 -3s-3.582 -3 -8 -3s-8 1.343 -8 3"></path>
                            <path d="M4 6v6c0 1.657 3.582 3 8 3c1.118 0 2.183 -.086 3.15 -.241"></path>
                            <path d="M20 12v-6"></path>
                            <path d="M4 12v6c0 1.657 3.582 3 8 3c.157 0 .312 -.002 .466 -.005"></path>
                            <path d="M16 19h6"></path>
                            <path d="M19 16l3 3l-3 3"></path>
                        </svg>
                        Process
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const selectedIdsInput = document.getElementById("selectedIds");
    const exportMultipleInvoice = document.getElementById("exportMultipleInvoice");
    const exportMultipleRow = document.getElementById("exportMultipleRow");
    const selectAll = document.getElementById("select-all");

    // Read selected items from localStorage (persistent across pages)
    function getStoredSelectedItems() {
        try {
            return JSON.parse(localStorage.getItem("billingSelectedItems") || "[]");
        } catch (e) {
            console.error("Error parsing billingSelectedItems:", e);
            return [];
        }
    }

    // Update export modal state based on stored selection
    function updateExportState() {
        const storedItems = getStoredSelectedItems();
        const joinedIds = storedItems.join(",");

        console.log('Export modal - stored items:', storedItems.length, 'items');
        console.log('Export modal - selectedIds input value:', joinedIds);

        // Update hidden input for form submission
        selectedIdsInput.value = joinedIds;

        // Enable/disable export options
        const hasSelection = storedItems.length > 0;
        exportMultipleInvoice.disabled = !hasSelection;
        exportMultipleRow.disabled = !hasSelection;

        // Reset radio if no selection
        if (!hasSelection) {
            const selectedRadio = document.querySelector("input[name='reportType']:checked");
            if (selectedRadio &&
                (selectedRadio.value === "MULTIPLE_INVOICE" || selectedRadio.value === "MULTIPLE_ROW")) {
                selectedRadio.checked = false;
            }
        }
    }

    // Watch for modal open to re-sync with latest localStorage
    const modal = document.getElementById("modal-export-billing");
    modal.addEventListener("show.bs.modal", updateExportState);

    // Detect user click on disabled export options
    [exportMultipleInvoice, exportMultipleRow].forEach(el => {
        el.closest(".form-selectgroup-item").addEventListener("click", (e) => {
            if (el.disabled) {
                e.preventDefault();
                Swal.fire({
                    icon: "warning",
                    title: "No Items Selected",
                    text: "Please select at least one billing record before exporting multiple.",
                    confirmButtonText: "OK",
                });
            }
        });
    });

    // Initialize on load
    updateExportState();

    // Handle form submission - use POST to avoid URL length limits
    const exportForm = document.querySelector("#modal-export-billing form");
    const exportSubmitBtn = document.getElementById("exportSubmitBtn");
    
    if (exportForm && exportSubmitBtn) {
        exportForm.addEventListener("submit", async function(e) {
            e.preventDefault(); // Prevent default form submission
            
            // Get form data
            const formData = new FormData(exportForm);
            const reportType = formData.get('reportType');
            const queryString = formData.get('queryString');
            const selectedIds = formData.get('selectedIds');
            
            // Validate report type selection
            if (!reportType) {
                Swal.fire({
                    icon: "warning",
                    title: "No Export Type Selected",
                    text: "Please select an export type.",
                    confirmButtonText: "OK",
                });
                return;
            }
            
            try {
                // Show loading indicator
                exportSubmitBtn.disabled = true;
                exportSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
                
                // Special handling for MULTIPLE_INVOICE - open in new tab for PDF downloads
                if (reportType === 'MULTIPLE_INVOICE') {
                    // Create form and submit to new tab
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/billing/exports';
                    form.target = '_blank';
                    
                    const typeInput = document.createElement('input');
                    typeInput.type = 'hidden';
                    typeInput.name = 'reportType';
                    typeInput.value = reportType;
                    form.appendChild(typeInput);
                    
                    const queryInput = document.createElement('input');
                    queryInput.type = 'hidden';
                    queryInput.name = 'queryString';
                    queryInput.value = queryString;
                    form.appendChild(queryInput);
                    
                    const idsInput = document.createElement('input');
                    idsInput.type = 'hidden';
                    idsInput.name = 'selectedIds';
                    idsInput.value = selectedIds;
                    form.appendChild(idsInput);
                    
                    document.body.appendChild(form);
                    form.submit();
                    document.body.removeChild(form);
                    
                    // Clear selections
                    localStorage.removeItem('billingSelectedItems');
                    console.log('Cleared billingSelectedItems after multiple invoice export');
                    
                    // Trigger clearAllSelections in Alpine.js component
                    const tableComponent = document.querySelector('[x-data]');
                    if (tableComponent && tableComponent.__x && tableComponent.__x.$data.clearAllSelections) {
                        tableComponent.__x.$data.clearAllSelections();
                    }
                    
                    // Close modal
                    const modalElement = document.getElementById('modal-export-billing');
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    
                    // Show info message
                    Swal.fire({
                        icon: "info",
                        title: "Opening Download Page",
                        text: "PDF invoices will be downloaded in a new tab.",
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    // Reload page to refresh UI
                    setTimeout(function() {
                        window.location.reload();
                    }, 2000);
                    
                    return;
                }
                
                // Send POST request for Excel exports
                const response = await fetch('/billing/exports', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        reportType: reportType,
                        queryString: queryString,
                        selectedIds: selectedIds
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // Get filename from Content-Disposition header
                const contentDisposition = response.headers.get('Content-Disposition');
                let filename = 'export.xlsx';
                if (contentDisposition) {
                    const matches = /filename="([^"]+)"/.exec(contentDisposition);
                    if (matches && matches[1]) {
                        filename = matches[1];
                    }
                }
                
                // Download the file
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                // Clear selections after successful export (for multiple selection types)
                if (reportType === 'MULTIPLE_ROW') {
                    localStorage.removeItem('billingSelectedItems');
                    console.log('Cleared billingSelectedItems after multiple selection export');
                    
                    // Trigger clearAllSelections in Alpine.js component
                    const tableComponent = document.querySelector('[x-data]');
                    if (tableComponent && tableComponent.__x && tableComponent.__x.$data.clearAllSelections) {
                        tableComponent.__x.$data.clearAllSelections();
                    }
                }
                
                // Close modal
                const modalElement = document.getElementById('modal-export-billing');
                const modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.hide();
                }
                
                // Show success message
                Swal.fire({
                    icon: "success",
                    title: "Export Complete",
                    text: "Your file has been downloaded successfully.",
                    timer: 2000,
                    showConfirmButton: false
                });
                
                // Reload page to refresh UI
                setTimeout(function() {
                    window.location.reload();
                }, 2000);
                
            } catch (error) {
                console.error('Export error:', error);
                Swal.fire({
                    icon: "error",
                    title: "Export Failed",
                    text: "Failed to export data. Please try again.",
                    confirmButtonText: "OK",
                });
            } finally {
                // Reset button state
                exportSubmitBtn.disabled = false;
                exportSubmitBtn.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="icon icon-tabler icon-tabler-database-export" width="24" height="24"
                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M4 6c0 1.657 3.582 3 8 3s8 -1.343 8 -3s-3.582 -3 -8 -3s-8 1.343 -8 3"></path>
                        <path d="M4 6v6c0 1.657 3.582 3 8 3c1.118 0 2.183 -.086 3.15 -.241"></path>
                        <path d="M20 12v-6"></path>
                        <path d="M4 12v6c0 1.657 3.582 3 8 3c.157 0 .312 -.002 .466 -.005"></path>
                        <path d="M16 19h6"></path>
                        <path d="M19 16l3 3l-3 3"></path>
                    </svg>
                    Process
                `;
            }
        });
    }
});
</script>



