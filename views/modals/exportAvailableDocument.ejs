<div class="modal modal-blur fade" id="modal-export-document" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <form action="/logs/exports">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Export Billing</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Export Type</label>
                    <div class="form-selectgroup-boxes row mb-3">
                        <input type="hidden" name="queryString" id="exportQueryString">
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="CURRENT" class="form-selectgroup-input" checked>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">This Page</span>
                                        <span class="d-block text-muted">Only export this page ( filter applied )</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="reportType" value="ENTIRE" class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Entire Records</span>
                                        <span class="d-block text-muted">Export entire records in database</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary ms-auto" data-bs-dismiss="modal">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-database-export"
                            width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M4 6c0 1.657 3.582 3 8 3s8 -1.343 8 -3s-3.582 -3 -8 -3s-8 1.343 -8 3"></path>
                            <path d="M4 6v6c0 1.657 3.582 3 8 3c1.118 0 2.183 -.086 3.15 -.241"></path>
                            <path d="M20 12v-6"></path>
                            <path d="M4 12v6c0 1.657 3.582 3 8 3c.157 0 .312 -.002 .466 -.005"></path>
                            <path d="M16 19h6"></path>
                            <path d="M19 16l3 3l-3 3"></path>
                        </svg>
                        Process
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Handle form submission - clear selections after export
        const exportForm = document.querySelector("#modal-export-document form");
        const exportSubmitBtn = document.querySelector("#modal-export-document button[type='submit']");
        
        if (exportSubmitBtn) {
            exportSubmitBtn.addEventListener("click", function(e) {
                // Clear selections after a short delay to allow form submission
                setTimeout(function() {
                    // Clear localStorage
                    localStorage.removeItem('billingSelectedItems');
                    console.log('Cleared billingSelectedItems after export');
                    
                    // Trigger clearAllSelections in Alpine.js component
                    const tableComponent = document.querySelector('[x-data]');
                    if (tableComponent && tableComponent.__x && tableComponent.__x.$data.clearAllSelections) {
                        tableComponent.__x.$data.clearAllSelections();
                    }
                    
                    // Reload page to refresh UI
                    setTimeout(function() {
                        window.location.reload();
                    }, 500);
                }, 200);
            });
        }
    });
</script>