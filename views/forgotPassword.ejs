<%- include('partials/header') -%>
<title>Reset Password | <%= appName %></title>

<body  class=" d-flex flex-column">
    <script src="/dist/js/demo-theme.min.js?1684106062"></script>
    <div class="page page-center" style="background-image: url(/static/background.jpg); background-color: rgba(0, 0, 0, 0.5); background-blend-mode: overlay;">
      <div class="container container-tight py-4">
        <%- include('partials/message') -%>
        <div class="card card-md">
          <div class="card-body">
            <div class="text-center mb-3">
              <a href="." class="navbar-brand navbar-brand-autodark"><img src="/static/logo.jpg" height="80" alt=""></a>
            </div>

            <h2 class="h2 text-center mb-4">Forgot Password</h2>
            <form action="/auth/forgot-password" method="post" autocomplete="on">
              <div class="mb-3">
                <label class="form-label">Enter Your Email</label>
                <input name="email" type="email" class="form-control" placeholder="Your Email" autocomplete="off">
              </div>
              <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Send Confirmation Email</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>

<%- include('partials/footer') -%>