<div class="table-responsive">
    <table class="table table-vcenter">
        <thead>
            <tr>
                <th class="text-center">Account ID</th>
                <th class="text-center">TO Emails</th>
                <th class="text-center">CC Emails</th>
                <th class="text-center">Created Date</th>
                <th class="text-center">Updated Date</th>
                <th class="w-1 text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (rejectedEmails && rejectedEmails.length> 0) { %>
                <% for(const config of rejectedEmails) { %>
                    <tr>
                        <td class="text-center">
                            <strong>
                                <%= config.accountID %>
                            </strong>
                        </td>
                        <td>
                            <div class="space-y-1">
                                <% if (Array.isArray(config.email_main_pic) && config.email_main_pic.length> 0) { %>
                                    <% config.email_main_pic.forEach(email=> { %>
                                        <% if (email && email.trim()) { %>
                                            <div class="badge bg-blue-lt mb-1">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="icon icon-tabler icon-tabler-mail" width="16" height="16"
                                                    viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                                    fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                                    <polyline points="3,7 12,13 21,7"></polyline>
                                                </svg>
                                                <%= email %> <small>(Main PIC)</small>
                                            </div>
                                            <% } %>
                                                <% }); %>
                                                    <% } %>
                                                        <% if (Array.isArray(config.email_comm) && config.email_comm.length> 0) { %>
                                                            <% config.email_comm.forEach(email=> { %>
                                                                <% if (email && email.trim()) { %>
                                                                    <div class="badge bg-green-lt mb-1">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            class="icon icon-tabler icon-tabler-mail"
                                                                            width="16" height="16" viewBox="0 0 24 24"
                                                                            stroke-width="2" stroke="currentColor"
                                                                            fill="none" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <path stroke="none" d="M0 0h24v24H0z"
                                                                                fill="none"></path>
                                                                            <rect x="3" y="5" width="18" height="14"
                                                                                rx="2"></rect>
                                                                            <polyline points="3,7 12,13 21,7">
                                                                            </polyline>
                                                                        </svg>
                                                                        <%= email %> <small>(Communication)</small>
                                                                    </div>
                                                                    <% } %>
                                                                        <% }); %>
                                                                            <% } %>
                                                                                <% if ((!Array.isArray(config.email_main_pic) ||
                                                                                    config.email_main_pic.length===0) &&
                                                                                    (!Array.isArray(config.email_comm) ||
                                                                                    config.email_comm.length===0)) { %>
                                                                                    <span class="text-muted">No TO
                                                                                        emails</span>
                                                                                    <% } %>
                            </div>
                        </td>
                        <td>
                            <div class="space-y-1">
                                <% if (Array.isArray(config.email_comm_manager) && config.email_comm_manager.length> 0) { %>
                                    <% config.email_comm_manager.forEach(email=> { %>
                                        <% if (email && email.trim()) { %>
                                            <div class="badge bg-orange-lt mb-1">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="icon icon-tabler icon-tabler-mail" width="16" height="16"
                                                    viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                                    fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                                    <polyline points="3,7 12,13 21,7"></polyline>
                                                </svg>
                                                <%= email %> <small>(Manager)</small>
                                            </div>
                                            <% } %>
                                                <% }); %>
                                                    <% } %>
                                                        <% if (Array.isArray(config.email_milist_com) &&
                                                            config.email_milist_com.length> 0) { %>
                                                            <% config.email_milist_com.forEach(email=> { %>
                                                                <% if (email && email.trim()) { %>
                                                                    <div class="badge bg-purple-lt mb-1">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            class="icon icon-tabler icon-tabler-mail"
                                                                            width="16" height="16" viewBox="0 0 24 24"
                                                                            stroke-width="2" stroke="currentColor"
                                                                            fill="none" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <path stroke="none" d="M0 0h24v24H0z"
                                                                                fill="none"></path>
                                                                            <rect x="3" y="5" width="18" height="14"
                                                                                rx="2"></rect>
                                                                            <polyline points="3,7 12,13 21,7">
                                                                            </polyline>
                                                                        </svg>
                                                                        <%= email %> <small>(Mailing List)</small>
                                                                    </div>
                                                                    <% } %>
                                                                        <% }); %>
                                                                            <% } %>
                                                                                <% if (Array.isArray(config.email_finance) &&
                                                                                    config.email_finance.length> 0) { %>
                                                                                    <%
                                                                                        config.email_finance.forEach(email=>
                                                                                        { %>
                                                                                        <% if (email && email.trim()) {
                                                                                            %>
                                                                                            <div
                                                                                                class="badge bg-yellow-lt mb-1">
                                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                                    class="icon icon-tabler icon-tabler-mail"
                                                                                                    width="16"
                                                                                                    height="16"
                                                                                                    viewBox="0 0 24 24"
                                                                                                    stroke-width="2"
                                                                                                    stroke="currentColor"
                                                                                                    fill="none"
                                                                                                    stroke-linecap="round"
                                                                                                    stroke-linejoin="round">
                                                                                                    <path stroke="none"
                                                                                                        d="M0 0h24v24H0z"
                                                                                                        fill="none">
                                                                                                    </path>
                                                                                                    <rect x="3" y="5"
                                                                                                        width="18"
                                                                                                        height="14"
                                                                                                        rx="2"></rect>
                                                                                                    <polyline
                                                                                                        points="3,7 12,13 21,7">
                                                                                                    </polyline>
                                                                                                </svg>
                                                                                                <%= email %>
                                                                                                    <small>(Finance)</small>
                                                                                            </div>
                                                                                            <% } %>
                                                                                                <% }); %>
                                                                                                    <% } %>
                                                                                                        <% if
                                                                                                            ((!Array.isArray(config.email_comm_manager)
                                                                                                            ||
                                                                                                            config.email_comm_manager.length===0)
                                                                                                            &&
                                                                                                            (!Array.isArray(config.email_milist_com)
                                                                                                            ||
                                                                                                            config.email_milist_com.length===0)
                                                                                                            &&
                                                                                                            (!Array.isArray(config.email_finance)
                                                                                                            ||
                                                                                                            config.email_finance.length===0))
                                                                                                            { %>
                                                                                                            <span
                                                                                                                class="text-muted">No
                                                                                                                CC
                                                                                                                emails</span>
                                                                                                            <% } %>
                            </div>
                        </td>
                        <td class="text-center">
                            <% if (config.createdAt) { %>
                                <code><%= moment(config.createdAt).format("MM/DD/YYYY HH:mm") %></code>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                    <% } %>
                        </td>
                        <td class="text-center">
                            <% if (config.updatedAt) { %>
                                <code><%= moment(config.updatedAt).format("MM/DD/YYYY HH:mm") %></code>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                    <% } %>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                    @click="openEditModal('<%= config._id %>')">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="16" height="16"
                                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                                        <path
                                            d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                                        <path d="M16 5l3 3" />
                                    </svg>
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                    @click="deleteConfig('<%= config._id %>', '<%= config.accountID %>')">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="16" height="16"
                                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <polyline points="3,6 5,6 21,6" />
                                        <path
                                            d="M19 6v14a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-14m3 0v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="empty">
                                        <div class="empty-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="48" height="48"
                                                viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <circle cx="12" cy="12" r="9" />
                                                <line x1="9" y1="9" x2="15" y2="15" />
                                                <line x1="15" y1="9" x2="9" y2="15" />
                                            </svg>
                                        </div>
                                        <p class="empty-title">No configurations found</p>
                                        <p class="empty-subtitle text-muted">
                                            Try adjusting your search or filter to find what you're looking for.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</div>

<!-- Pagination -->
<% if (rejectedEmails && rejectedEmails.length> 0) { %>
    <nav aria-label="Page navigation">
        <div class="text-center mb-2">
            Showing <%= startIdx %> to <%= endIdx %> of <%= totalEmails %> configurations
        </div>
        <ul class="pagination justify-content-center">
            <li class="page-item<%= currentPage === 1 ? ' disabled' : '' %>">
                <a class="page-link" href="?<%= queryString %>&page=1&pageSize=<%= pageSize %>">First</a>
            </li>
            <li class="page-item<%= currentPage === 1 ? ' disabled' : '' %>">
                <a class="page-link"
                    href="?<%= queryString %>&page=<%= currentPage - 1 %>&pageSize=<%= pageSize %>">Previous</a>
            </li>
            <li class="page-item<%= currentPage === totalPages ? ' disabled' : '' %>">
                <a class="page-link"
                    href="?<%= queryString %>&page=<%= currentPage + 1 %>&pageSize=<%= pageSize %>">Next</a>
            </li>
            <li class="page-item<%= currentPage === totalPages ? ' disabled' : '' %>">
                <a class="page-link" href="?<%= queryString %>&page=<%= totalPages %>&pageSize=<%= pageSize %>">Last</a>
            </li>
        </ul>
    </nav>
    <% } %>