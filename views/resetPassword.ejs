<%- include('partials/header') -%>
<title>Reset Password | <%= appName %></title>

<body class=" d-flex flex-column">
  <script src="/dist/js/demo-theme.min.js?1684106062"></script>
  <div class="page page-center"
    style="background-image: url(/static/background.jpg); background-color: rgba(0, 0, 0, 0.5); background-blend-mode: overlay;">
    <div class="container container-tight py-4">
      <%- include('partials/message') -%>
      <div class="card card-md">
        <div class="card-body">
          <div class="text-center mb-3">
            <a href="." class="navbar-brand navbar-brand-autodark"><img src="/static/logo.jpg" height="80" alt=""></a>
          </div>

          <h2 class="h2 text-center mb-4">Reset Your Password</h2>
          <form action="/auth/reset-password" method="post" autocomplete="on">
            <input name="id" type="hidden" value="<%= id %>">
            <input name="token" type="hidden" value="<%= token %>">
            <div class="mb-3">
              <label class="form-label">Password</label>
              <div class="input-group input-group-flat">
                <input name="password" type="password" class="form-control" placeholder="New Password"
                  autocomplete="off">
                <span class="input-group-text">
                  <a href="#" class="link-secondary" title="Show password" data-bs-toggle="tooltip">
                    <!-- Download SVG icon from http://tabler-icons.io/i/eye -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                      stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                      <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                    </svg>
                  </a>
                </span>
              </div>
            </div>
            <div class="mb-2">
              <div class="input-group input-group-flat">
                <input name="confirmPassword" type="password" class="form-control" placeholder="Confirm password"
                  autocomplete="off">
                <span class="input-group-text">
                  <a href="#" class="link-secondary" title="Show password" data-bs-toggle="tooltip">
                    <!-- Download SVG icon from http://tabler-icons.io/i/eye -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                      stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                      <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                    </svg>
                  </a>
                </span>
              </div>
            </div>
            <div class="form-footer">
              <button type="submit" class="btn btn-primary w-100">Submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const passwordInput = document.querySelector('input[name="password"]');
      const confirmPasswordInput = document.querySelector('input[name="confirmPassword"]');
      const inputGroup = confirmPasswordInput.closest('.input-group');
      const errorMsg = document.createElement('div');

      errorMsg.textContent = "Passwords don't match!";
      errorMsg.style.color = "red";
      errorMsg.style.display = "none";
      inputGroup.parentNode.insertBefore(errorMsg, inputGroup);

      function validatePasswords() {
        if (passwordInput.value !== confirmPasswordInput.value) {
          errorMsg.style.display = "block";
        } else {
          errorMsg.style.display = "none";
        }
      }

      passwordInput.addEventListener("input", validatePasswords);
      confirmPasswordInput.addEventListener("input", validatePasswords);
    });
  </script>
</body>

<%- include('partials/footer') -%>