<%- include('partials/header') -%>
    <title>Billing Monitor | <%= appName %>
    </title>

    <style>
        .dropzone .dz-preview .dz-remove {
            position: absolute;
            top: 5px;
            left: 5px;
            right: 5px;
            z-index: 1000;
            /* Ensure it's above other elements */
        }

        .row-cancelled {
            background-color: rgba(250, 128, 114, 0.1);
        }

    </style>

    <script>
        let clNumber = '';
        document.addEventListener('alpine:init', () => {
            Alpine.data('billing', () => ({
                billing: {},
                clNumber: null,
                id: null,
                queryString: '',
                fillBillingData(item) {
                    this.billing = item;
                    clNumber = item.invoice.clnumber;
                    this.clNumber = clNumber;
                    this.id = item._id.toString();

                    try {
                        const urlParams = new URLSearchParams(window.location.search);
                        const searchingParameter = window.location.search;
                        this.queryString = searchingParameter;
                    } catch (e) {
                        console.error(e);
                    }
                },
                resendEmail(item) {
                    const url = `/api/invoices/resend-email/${item._id}`;
                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: null,
                    })
                        .then(response => response.json())
                        .then(data => {
                            Swal.fire('Success', 'Email resend successfully', 'success');
                        })
                        .catch((error) => {
                            Swal.fire('Error', 'Failed to resend Email', 'error');
                        });
                },
            }));
        });

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);

            const searchingParameter = window.location.search;
            document.getElementById('exportQueryString').value = searchingParameter;

            document.querySelector("input[name='customerName']").value = urlParams.get('customerName') || '';
            document.querySelector("input[name='pic']").value = urlParams.get('pic') || '';
            document.querySelector("input[name='accountID']").value = urlParams.get('accountID') || '';
            document.querySelector("input[name='clNumber']").value = urlParams.get('clNumber') || '';
            document.querySelector("input[name='clDate']").value = urlParams.get('clDate') || '';
            document.querySelector("input[name='invoiceNo']").value = urlParams.get('invoiceNo') || '';
            document.querySelector("input[name='invoiceDate']").value = urlParams.get('invoiceDate') || '';
            document.querySelector("input[name='emailSent']").value = urlParams.get('emailSent') || '';
            document.querySelector("input[name='emailSentDate']").value = urlParams.get('emailSentDate') || '';
            document.querySelector("select[name='billingStatus']").value = urlParams.get('billingStatus') || '';
        });
    </script>

    <body x-data="billing">
        <script src="/dist/js/demo-theme.min.js?1684106062"></script>
        <div class="page">
            <!-- Sidebar -->
            <%- include('partials/sidebar') -%>
                <div class="page-wrapper">
                    <!-- Page header -->
                    <div class="page-header d-print-none">
                        <div class="container-xl">
                            <div class="row g-2 align-items-center">
                                <div class="col">
                                    <!-- Page pre-title -->
                                    <div class="page-pretitle">
                                        Overview
                                    </div>
                                    <h2 class="page-title">
                                        Billing Monitoring
                                    </h2>
                                </div>
                                <!-- Page title actions -->
                                <div class="col-auto ms-auto d-print-none">
                                    <div class="btn-list">
                                        <a href="#" class="btn btn-primary d-none d-sm-inline-block"
                                            data-bs-toggle="modal" data-bs-target="#modal-export-billing">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="icon icon-tabler icon-tabler-database-export" width="24"
                                                height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                                fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path
                                                    d="M4 6c0 1.657 3.582 3 8 3s8 -1.343 8 -3s-3.582 -3 -8 -3s-8 1.343 -8 3">
                                                </path>
                                                <path d="M4 6v6c0 1.657 3.582 3 8 3c1.118 0 2.183 -.086 3.15 -.241">
                                                </path>
                                                <path d="M20 12v-6"></path>
                                                <path d="M4 12v6c0 1.657 3.582 3 8 3c.157 0 .312 -.002 .466 -.005">
                                                </path>
                                                <path d="M16 19h6"></path>
                                                <path d="M19 16l3 3l-3 3"></path>
                                            </svg>
                                            Export
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Page body -->
                    <div class="page-body">
                        <div class="container-fluid">
                            <%- include('fieldset/filterBilling') -%>
                                <div class="row row-cards">
                                    <div class="col-lg-12">
                                        <div class="card">
                                            <%- include('tables/billing') -%>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>

                    <!-- Modal Manual Billing -->
                    <%- include('modals/manualBilling') -%>

                        <!-- Modal Upload Billing -->
                        <%- include('modals/uploadBilling') -%>

                            <!-- Modal Export Billing -->
                            <%- include('modals/exportBilling') -%>

                                <!-- Modal Cancel & Reject Reason -->
                                <%- include('modals/reason') -%>

                                    <!-- Modal Resend Email -->
                                    <%- include('modals/resend') -%>

                </div>
        </div>

        <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
        <script>

            document.addEventListener("DOMContentLoaded", function () {
                let dropzoneInstance = new Dropzone("#dropzone-custom", {
                    maxFiles: 1,
                    url: '/api/invoices/upload-file',
                    paramName: 'file',
                    acceptedFiles: '.xlsx,.pdf,.xls',
                    maxFilesize: 10,
                    addRemoveLinks: true,
                });

                dropzoneInstance.on("addedfile", function () {
                    while (this.files.length > this.options.maxFiles) {
                        this.removeFile(this.files[0]);
                    }
                });

                dropzoneInstance.on("sending", function (file, xhr, formData) {
                    formData.append("filename", clNumber);
                });

                document.getElementById("clear-dropzone").addEventListener("click", function () {
                    dropzoneInstance.removeAllFiles(true);
                });
            });
        </script>
        <script>
            new Litepicker({
                element: document.getElementById('dateRangeCLDate'),
                singleMode: false,
                allowRepick: true,
                numberOfMonths: 1,
                showMonthYearPickers: true, // enable month and year dropdowns
                dropdowns: {
                    minYear: 2000,
                    maxYear: null,
                    months: true,
                    years: true
                },
            });

            new Litepicker({
                element: document.getElementById('dateRangeInvoiceDate'),
                singleMode: false,
                allowRepick: true,
                numberOfMonths: 1,
                showMonthYearPickers: true, // enable month and year dropdowns
                dropdowns: {
                    minYear: 2000,
                    maxYear: null,
                    months: true,
                    years: true
                },
            });

            new Litepicker({
                element: document.getElementById('dateRangeEmailSentDate'),
                singleMode: false,
                allowRepick: true,
                numberOfMonths: 1,
                showMonthYearPickers: true, // enable month and year dropdowns
                dropdowns: {
                    minYear: 2000,
                    maxYear: null,
                    months: true,
                    years: true
                },
            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const SELECTED_KEY = "selectedItems";

                // Function to clear localStorage, uncheck boxes, and reset Alpine data
                function clearSelectedItems() {
                    localStorage.removeItem(SELECTED_KEY);
                    console.log("Cleared selectedItems from localStorage");

                    // Uncheck all checkboxes
                    document.querySelectorAll('.select-item').forEach(cb => cb.checked = false);
                    const selectAll = document.querySelector('#select-all');
                    if (selectAll) selectAll.checked = false;

                    // Reset Alpine.js data (if exists)
                    if (window.Alpine && Alpine.store) {
                        try {
                            const tableComponent = document.querySelector('[x-data]');
                            if (tableComponent && tableComponent.__x) {
                                tableComponent.__x.$data.selectedItems = [];
                            }
                        } catch (e) {
                            console.warn("Alpine reset skipped:", e);
                        }
                    }

                    // Update text showing selected count (if exists)
                    const selectedText = document.querySelector('[x-text*="selectedItems.length"]');
                    if (selectedText) selectedText.innerText = `0 selected`;
                }

                // When Filter button (submit form)
                const billingForm = document.querySelector('form[action="/billing"][method="get"]');
                if (billingForm) {
                    billingForm.addEventListener("submit", () => {
                        clearSelectedItems();
                    });
                }

                // When Clear link is clicked
                const clearLink = document.querySelector('a[href="/billing"]');
                if (clearLink) {
                    clearLink.addEventListener("click", () => {
                        clearSelectedItems();
                    });
                }

                // Also when Export Billing form is submitted (if exists)
                const exportForm = document.querySelector("#modal-export-billing form");
                if (exportForm) {
                    exportForm.addEventListener("submit", () => {
                        clearSelectedItems();
                    });
                }

                // Automatically clear when user leaves /billing page
                window.addEventListener("beforeunload", () => {
                    if (!window.location.pathname.startsWith("/billing")) {
                        clearSelectedItems();
                    }
                });
            });
        </script>
        <% if (clearSelected) { %>
            <script>
                console.log("Clearing selectedItems because query is empty");
                localStorage.removeItem("selectedItems");

                // Uncheck all checkboxes
                document.querySelectorAll('.select-item').forEach(cb => cb.checked = false);
                const selectAll = document.querySelector('#select-all');
                if (selectAll) selectAll.checked = false;

                // Reset selected count if you show it
                const selectedText = document.querySelector('[x-text*="selectedItems.length"]');
                if (selectedText) selectedText.innerText = '0 selected';
            </script>
        <% } %>

    </body>

    <%- include('partials/footer') -%>