    <%- include('partials/header') -%>
    <title>Management Users | <%= appName %></title>


    <script>

        document.addEventListener('alpine:init', () => {
            Alpine.data('users', () => ({
                user: {},
                fillUserData(item) {
                    this.user = item;
                },
                resetPassword(item) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This user's password will be reset to his email.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Continue'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const config = {
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                            };

                            const body = {
                                id: item._id
                            };
                            axios.post('/users/reset-password', body, config)
                                .then(response => {
                                    Swal.fire('Success', 'Password reset email sent.',
                                        'success');
                                })
                                .catch(error => {
                                    Swal.fire('Error', 'Something went wrong.',
                                        'error');
                                });
                        }
                    })
                },
                deleteUser(item) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This user will be deleted permanently.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Continue'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const config = {
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                            };

                            const body = {
                                id: item._id
                            };
                            axios.delete(`/users/${item._id}`, body, config)
                                .then(response => {
                                    Swal.fire('Success', 'User deleted successfully.',
                                        'success').then(() => {
                                        window.location.reload();
                                    });
                                })
                                .catch(error => {
                                    Swal.fire('Error', 'Something went wrong.',
                                        'error');
                                });
                        }
                    })
                },
            }));
        });
    </script>

    <body x-data="users">
        <script src="/dist/js/demo-theme.min.js?1684106062"></script>
        <div class="page">
            <!-- Sidebar -->
            <%- include('partials/sidebar') -%>
            <div class="page-wrapper">
                <!-- Page header -->
                <div class="page-header d-print-none">
                    <div class="container-xl">
                        <div class="row g-2 align-items-center">
                            <div class="col">
                                <!-- Page pre-title -->
                                <div class="page-pretitle">
                                    Overview
                                </div>
                                <h2 class="page-title">
                                    Management Users
                                </h2>
                            </div>
                            <!-- Page title actions -->
                            <div class="col-auto ms-auto d-print-none">
                                <div class="btn-list">
                                    <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal"
                                        data-bs-target="#modal-add-user">
                                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M12 5l0 14" />
                                            <path d="M5 12l14 0" /></svg>
                                        Add Admin
                                    </a>
                                    <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal"
                                        data-bs-target="#modal-add-user" aria-label="Add User">
                                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M12 5l0 14" />
                                            <path d="M5 12l14 0" /></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Page body -->
                <div class="page-body">
                    <div class="container-xl">

                        <form action="/users" method="get">
                            <fieldset class="form-fieldset">
                                <div class="row">
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Name</label>
                                        <input name="name" type="text" class="form-control" autocomplete="off"
                                            placeholder="John Doe" />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Role</label>
                                        <select name="role" class="form-select">
                                            <option value="">Role</option>
                                            <option value="ADMIN">Admin</option>
                                            <option value="USER">User</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Username/Email</label>
                                        <input name="email" type="text" class="form-control" autocomplete="off"
                                            placeholder="mail1@mail.com" />
                                    </div>
                                </div>
                                <div class="btn-list">
                                    <a class="btn btn-white" href="/users">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="icon icon-tabler icon-tabler-circle-letter-x" width="24" height="24"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                            <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                                            <path d="M10 8l4 8"></path>
                                            <path d="M10 16l4 -8"></path>
                                        </svg>
                                        Clear
                                    </a>
                                    <button type="submit" class="btn btn-info">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="icon icon-tabler icon-tabler-adjustments-alt" width="24" height="24"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                            <path d="M4 8h4v4h-4z"></path>
                                            <path d="M6 4l0 4"></path>
                                            <path d="M6 12l0 8"></path>
                                            <path d="M10 14h4v4h-4z"></path>
                                            <path d="M12 4l0 10"></path>
                                            <path d="M12 18l0 2"></path>
                                            <path d="M16 5h4v4h-4z"></path>
                                            <path d="M18 4l0 1"></path>
                                            <path d="M18 9l0 11"></path>
                                        </svg>
                                        Filter
                                    </button>
                                </div>
                            </fieldset>
                        </form>

                        <div class="row row-cards">
                            <div class="col-lg-12">
                                <%- include('partials/message') -%>
                                <div class="card">
                                    <div class="table-responsive">
                                        <table class="table table-vcenter card-table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Role</th>
                                                    <th>Username</th>
                                                    <th>Password</th>
                                                    <th>Contact</th>
                                                    <th class="w-1"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% for (item of users) { %>
                                                <tr>
                                                    <td><%= item.name %></td>
                                                    <td class="text-muted">
                                                        <%= item.role %>
                                                    </td>
                                                    <td class="text-muted"><a href="#"
                                                            class="text-reset"><%= item.email %></a></td>
                                                    <td class="text-muted"><a href="#" class="text-reset">*******</a>
                                                    </td>
                                                    <td><%= item.contact %></td>
                                                    <td class="btn-list flex-nowrap">
                                                        <a href="#" data-bs-toggle="modal"
                                                            data-bs-target="#modal-edit-user"
                                                            @click="fillUserData(JSON.parse($el.getAttribute('data-item')))"
                                                            :data-item="'<%= JSON.stringify(item) %>'">Edit</a>
                                                        <a class="text text-warning"
                                                            @click="resetPassword(JSON.parse($el.getAttribute('data-item')))"
                                                            :data-item="'<%= JSON.stringify(item) %>'">Reset</a>
                                                        <a class="text text-danger"
                                                            @click="deleteUser(JSON.parse($el.getAttribute('data-item')))"
                                                            :data-item="'<%= JSON.stringify(item) %>'">Delete</a>
                                                    </td>
                                                </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <br>
                                    <!-- Pagination -->
                                    <nav aria-label="Page navigation">
                                        <div class="text-center mb-2">
                                            Showing <%= startIdx %> to <%= endIdx %> of <%= totalUsers %> users
                                        </div>
                                        <ul class="pagination justify-content-center">
                                            <li class="page-item<%= currentPage === 1 ? ' disabled' : '' %>">
                                                <a class="page-link" href="?<%= queryString %>&page=1&pageSize=<%= pageSize %>">First</a>
                                            </li>
                                            <li class="page-item<%= currentPage === 1 ? ' disabled' : '' %>">
                                                <a class="page-link" href="?<%= queryString %>&page=<%= currentPage - 1 %>&pageSize=<%= pageSize %>">Previous</a>
                                            </li>
                                            <li class="page-item<%= currentPage === totalPages ? ' disabled' : '' %>">
                                                <a class="page-link" href="?<%= queryString %>&page=<%= currentPage + 1 %>&pageSize=<%= pageSize %>">Next</a>
                                            </li>
                                            <li class="page-item<%= currentPage === totalPages ? ' disabled' : '' %>">
                                                <a class="page-link" href="?<%= queryString %>&page=<%= totalPages %>&pageSize=<%= pageSize %>">Last</a>
                                            </li>
                                        </ul>
                                    </nav>
                                    <!-- End Pagination -->

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Add User -->
        <%- include('modals/addUsers') -%>

        <!-- Modal Edit User -->
        <%- include('modals/editUsers') -%>

        <!-- Tabler Core -->
        <script src="/dist/js/tabler.min.js?1684106062" defer></script>
        <script src="/dist/js/demo.min.js?1684106062" defer></script>
        <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    </body>

    <%- include('partials/footer') -%>