                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="16" height="16"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
                                            <polyline points="7,11 12,16 17,11" />
                                            <line x1="12" y1="4" x2="12" y2="16" />
                                        </svg>
                                        Download Template
                                    </a>
                                    <small class="text-muted ms-2">Use this template to ensure correct format</small>
                                </div>
                                <p class="mt-2 mb-0"><small><strong>Note:</strong> For multiple emails in one field,
                                        separate them with semicolons (;).
                                        Example: email1@domain.com;email2@domain.com</small></p>
                            </div>
                        </div>

                        <!-- File Upload -->
                        <div class="mb-3" x-show="!bulkImportResult && !bulkImportLoading">
                            <label class="form-label">Select Excel File</label>
                            <input type="file" class="form-control" accept=".xlsx,.xls"
                                @change="handleFileSelect($event)" :disabled="bulkImportLoading">
                            <small class="form-hint">
                                Supported formats: .xlsx, .xls (Max size: 50MB)
                            </small>
                        </div>

                        <!-- Loading -->
                        <div x-show="bulkImportLoading" class="text-center py-5">
                            <div class="mb-3">
                                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"
                                    role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                            <h4 class="text-primary mb-2">Processing Excel File...</h4>
                            <p class="text-muted mb-3">Please wait while we import your data</p>
                            <div class="progress mb-3" style="max-width: 400px; margin: 0 auto;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                                    style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <p class="text-muted small">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-info-circle"
                                    width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                    fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <circle cx="12" cy="12" r="9" />
                                    <line x1="12" y1="8" x2="12.01" y2="8" />
                                    <polyline points="11 12 12 12 12 16 13 16" />
                                </svg>
                                This may take a few moments for large files
                            </p>
                        </div>

                        <!-- Results -->
                        <div x-show="bulkImportResult" class="mt-3">
                            <!-- Success -->
                            <div x-show="bulkImportResult?.success" class="alert alert-success" role="alert">
                                <h4 class="alert-title">Import Completed Successfully!</h4>
                                <div class="text-muted">
                                    <ul class="mb-0">
                                        <li><strong x-text="bulkImportResult?.results?.inserted || 0"></strong> new
                                            configurations created</li>
                                        <li><strong x-text="bulkImportResult?.results?.updated || 0"></strong> existing
                                            configurations updated</li>
                                        <li><strong x-text="bulkImportResult?.results?.skipped || 0"></strong> records
                                            skipped (no changes)</li>
                                        <li x-show="bulkImportResult?.results?.errors?.length > 0">
                                            <strong x-text="bulkImportResult?.results?.errors?.length || 0"></strong>
                                            errors encountered
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Errors Detail -->
                            <div x-show="bulkImportResult?.results?.errors?.length > 0" class="mt-3">
                                <div class="card">
                                    <div class="card-header">
                                        <h4 class="card-title text-danger">Errors</h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="list-group list-group-flush"
                                            style="max-height: 200px; overflow-y: auto;">
                                            <template x-for="(error, index) in bulkImportResult?.results?.errors"
                                                :key="index">
                                                <div class="list-group-item">
                                                    <div class="row align-items-center">
                                                        <div class="col-auto">
                                                            <span class="badge bg-red"></span>
                                                        </div>
                                                        <div class="col text-truncate">
                                                            <span class="text-reset d-block"
                                                                x-text="error.accountID || 'Row ' + error.row"></span>
                                                            <div class="text-muted text-truncate mt-n1"
                                                                x-text="error.error"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Error -->
                            <div x-show="!bulkImportResult?.success" class="alert alert-danger" role="alert">
                                <h4 class="alert-title">Import Failed</h4>
                                <div class="text-muted" x-text="bulkImportResult?.message"></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" @click="closeBulkImportModal()"
                            :disabled="bulkImportLoading">
                            <span x-text="bulkImportResult ? 'Close' : 'Cancel'"></span>
                        </button>
                        <button type="button" class="btn btn-success ms-auto" @click="uploadBulkImport()"
                            :disabled="!bulkImportFile || bulkImportLoading" x-show="!bulkImportResult">
                            <span x-show="!bulkImportLoading">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24"
                                    viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M7 18a4.6 4.4 0 0 1 0 -9a5 4.5 0 0 1 11 2h1a3.5 3.5 0 0 1 0 7h-1" />
                                    <polyline points="9,15 12,12 15,15" />
                                    <line x1="12" y1="12" x2="12" y2="21" />
                                </svg>
                                Upload and Import
                            </span>
                            <span x-show="bulkImportLoading">
                                <span class="spinner-border spinner-border-sm me-2" role="status"
                                    aria-hidden="true"></span>
                                Processing...
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bulk Import Backdrop -->
        <div class="modal-backdrop fade" :class="{ 'show': showBulkImportModal }" :style="{ 
                display: showBulkImportModal ? 'block' : 'none',
                cursor: bulkImportLoading ? 'wait' : 'pointer'
            }" @click="closeBulkImportModal()"></div>

        <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    </body>

    <%- include('partials/footer') -%>