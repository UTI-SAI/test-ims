<%- include('partials/header') -%>
    <title>Rejected Invoice Email Settings | <%= appName %>
    </title>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('rejectedEmailManager', () => ({
                config: {},
                isEditMode: false,
                showModal: false,
                showBulkImportModal: false,
                bulkImportFile: null,
                bulkImportLoading: false,
                bulkImportResult: null,

                // Initialize form data
                initForm() {
                    this.config = {
                        _id: '',
                        accountID: '',
                        email_main_pic: [''],
                        email_comm: [''],
                        email_comm_manager: [''],
                        email_milist_com: [''],
                        email_finance: ['']
                    };
                    this.isEditMode = false;
                },

                // Open create modal
                openCreateModal() {
                    this.initForm();
                    this.showModal = true;
                },

                // Open edit modal
                async openEditModal(id) {
                    try {
                        const response = await fetch(`/rejected-invoice-emails/${id}`);
                        const result = await response.json();

                        if (result.success) {
                            // Ensure arrays for email fields
                            this.config = {
                                ...result.data,
                                email_main_pic: Array.isArray(result.data.email_main_pic) ? result.data.email_main_pic : (result.data.email_main_pic ? [result.data.email_main_pic] : []),
                                email_comm: Array.isArray(result.data.email_comm) ? result.data.email_comm : (result.data.email_comm ? [result.data.email_comm] : []),
                                email_comm_manager: Array.isArray(result.data.email_comm_manager) ? result.data.email_comm_manager : (result.data.email_comm_manager ? [result.data.email_comm_manager] : []),
                                email_milist_com: Array.isArray(result.data.email_milist_com) ? result.data.email_milist_com : (result.data.email_milist_com ? [result.data.email_milist_com] : []),
                                email_finance: Array.isArray(result.data.email_finance) ? result.data.email_finance : (result.data.email_finance ? [result.data.email_finance] : [])
                            };
                            this.isEditMode = true;
                            this.showModal = true;
                        } else {
                            alert('Error loading configuration: ' + result.message);
                        }
                    } catch (error) {
                        alert('Error loading configuration');
                        console.error(error);
                    }
                },

                // Submit form
                async submitForm() {
                    try {
                        const formData = {
                            accountID: this.config.accountID,
                            email_main_pic: this.config.email_main_pic,
                            email_comm: this.config.email_comm,
                            email_comm_manager: this.config.email_comm_manager,
                            email_milist_com: this.config.email_milist_com,
                            email_finance: this.config.email_finance
                        };

                        let url, method;
                        if (this.isEditMode) {
                            url = `/rejected-invoice-emails/${this.config._id}`;
                            method = 'PUT';
                        } else {
                            url = '/rejected-invoice-emails/create';
                            method = 'POST';
                        }

                        const response = await fetch(url, {
                            method: method,
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(formData)
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.showModal = false;
                            location.reload();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    } catch (error) {
                        alert('Error saving configuration');
                        console.error(error);
                    }
                },

                // Delete configuration
                async deleteConfig(id, accountID) {
                    if (confirm(`Are you sure you want to delete configuration for ${accountID}?`)) {
                        try {
                            const response = await fetch(`/rejected-invoice-emails/${id}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json',
                                }
                            });

                            const result = await response.json();

                            if (result.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + result.message);
                            }
                        } catch (error) {
                            alert('Error deleting configuration');
                            console.error(error);
                        }
                    }
                },


                // Open bulk import modal
                openBulkImportModal() {
                    this.showBulkImportModal = true;
                    this.bulkImportFile = null;
                    this.bulkImportResult = null;
                },

                // Handle file selection
                handleFileSelect(event) {
                    const file = event.target.files[0];
                    if (file) {
                        this.bulkImportFile = file;
                    }
                },

                // Upload bulk import file
                async uploadBulkImport() {
                    if (!this.bulkImportFile) {
                        alert('Please select a file to upload');
                        return;
                    }

                    this.bulkImportLoading = true;
                    this.bulkImportResult = null;

                    try {
                        const formData = new FormData();
                        formData.append('file', this.bulkImportFile);

                        const response = await fetch('/rejected-invoice-emails/bulk-import', {
                            method: 'POST',
                            body: formData
                        });

                        // Check if response is JSON
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            throw new Error('Server returned an invalid response. Please check console for details.');
                        }

                        const result = await response.json();

                        this.bulkImportResult = result;
                        this.bulkImportLoading = false;

                        if (result.success) {
                            // Show success message with details
                            setTimeout(() => {
                                location.reload();
                            }, 3000);
                        }
                    } catch (error) {
                        this.bulkImportLoading = false;
                        console.error('Upload error:', error);

                        // Show user-friendly error
                        this.bulkImportResult = {
                            success: false,
                            message: error.message || 'An error occurred while uploading the file. Please try again.'
                        };
                    }
                },

                // Close bulk import modal
                closeBulkImportModal() {
                    // Prevent closing modal while processing
                    if (this.bulkImportLoading) {
                        return;
                    }
                    this.showBulkImportModal = false;
                    this.bulkImportFile = null;
                    this.bulkImportResult = null;
                }

            }));
        });
    </script>

