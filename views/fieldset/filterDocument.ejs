<form action="/document" method="get">
    <fieldset class="form-fieldset">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Account ID</label>
                <input type="text" class="form-control" autocomplete="off" placeholder="ID_00X" name="accountID"/>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Customer Name</label>
                <input type="text" class="form-control" autocomplete="off" placeholder="John Doe" name="customerName"/>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">CL Number</label>
                <input type="text" class="form-control" autocomplete="off" placeholder="CL21agusXXX" name="clNumber" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Invoice Number</label>
                <input type="text" class="form-control" autocomplete="off" placeholder="INV_00XX" name="invoiceNo">
            </div>
        </div>
        <div class="row">
            <div class="col-md-2 mb-3">
                <label class="form-label">CL Date</label>
                <input type="text" class="form-control" autocomplete="off" name="clDate" id="dateRangeCLDate" />
            </div>
            <div class="col-md-2 mb-3">
                <label class="form-label">Invoice Date</label>
                <input type="text" class="form-control" autocomplete="off" name="invoiceDate" id="dateRangeInvoiceDate" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="">Status</option>
                    <option value="INVOICE SENT">Invoice Sent</option>
                    <option value="INVOICE EMAIL NOT SEND">Invoice Email Not Send</option>
                    <!-- <option value="EMAIL NOT FOUND">Email Not Found</option> -->
                    <option value="E-MATERAI NOT ATTACHED">E-Meterai Not Attached</option>
                    <option value="DOCUMENT NOT COMPLETE">Document Not Complete</option>
                    <option value="ARCHIVE HC">Archive HC</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Status Remark</label>
                <select class="form-select" name="statusRemark">
                    <option value="">Status Remark</option>
                    <option value="NEED INVOICE">Need Invoice</option>
                    <option value="NEED DEBIT NOTE">Need Debit Note</option>
                    <option value="NEED FAKTUR PAJAK">Need Faktur Pajak</option>
                    <option value="NEED SUPPDOC">Need Suppdoc</option>
                    <option value="NEED MATERAI">Need Materai</option>
                    <option value="NEED STATUS SUPPDOC">Need Status Suppdoc</option>
                </select>
            </div>
        </div>
        <div class="btn-list">
            <a href="/document" class="btn">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-circle-letter-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                    <path d="M10 8l4 8"></path>
                    <path d="M10 16l4 -8"></path>
                 </svg>
                Clear
            </a>
            <button type="submit" class="btn btn-info">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-adjustments-alt" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M4 8h4v4h-4z"></path>
                    <path d="M6 4l0 4"></path>
                    <path d="M6 12l0 8"></path>
                    <path d="M10 14h4v4h-4z"></path>
                    <path d="M12 4l0 10"></path>
                    <path d="M12 18l0 2"></path>
                    <path d="M16 5h4v4h-4z"></path>
                    <path d="M18 4l0 1"></path>
                    <path d="M18 9l0 11"></path>
                 </svg>
                Filter
              </button>
        </div>
    </fieldset>
</form>